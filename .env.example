# Optional GitHub token raises API rate limits. Obtain from GitHub Settings > Developer settings.
# Start without it; do not commit real tokens.
GITHUB_TOKEN=

# Telegram is optional. Create a bot with BotFather and obtain your chat ID separately.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Discovery sources
TASK_GAP_GITHUB_ENABLED=true
TASK_GAP_GITHUB_PAGES=1
TASK_GAP_GITHUB_PER_PAGE=30
TASK_GAP_PROBLEMS_ENABLED=true
TASK_GAP_PROBLEMS_LIMIT=60
# Add public RSS/Atom feeds separated by semicolons. Example: https://example.org/feed.xml
TASK_GAP_RSS_URLS=

# Only alert on new candidate records whose heuristic score reaches this value.
TASK_GAP_ALERT_SCORE=55
TASK_GAP_DB=task_gap_hunter.sqlite3
