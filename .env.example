# Keep secrets out of Git. Set these in Render's Environment settings.
SOLVEEASE_RUN_TOKEN=replace-with-a-long-random-secret
SOLVEEASE_DB_PATH=/var/data/solveease_ledger.sqlite3
# Optional override; leave blank to use the default public problem-report endpoint.
SOLVEEASE_PROBLEM_REPORTS_URL=https://problems.fru.dev/api/problems
PORT=10000
